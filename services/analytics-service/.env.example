# analytics-service Environment Configuration
# Copy this file to .env and fill in the appropriate values for your environment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port on which the analytics service will listen for incoming requests
PORT=3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection URL for persistent storage of analytics data
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://analytics_user:your_password_here@localhost:5432/analytics_db

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Redis connection URL used for caching, session management, and rate limiting
# Format: redis://[:PASSWORD@]HOST:PORT[/DATABASE_NUMBER]
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# MESSAGE BROKER CONFIGURATION
# =============================================================================

# Comma-separated list of Kafka broker addresses for consuming event streams
# Format: HOST1:PORT1,HOST2:PORT2,HOST3:PORT3
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================

# Deployment environment for the service
# Accepted values: development | staging | production | test
ENVIRONMENT=development

# Logging verbosity level for the service
# Accepted values: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# =============================================================================
# ANALYTICS PROCESSING CONFIGURATION
# =============================================================================

# Time window (in seconds) used for aggregating analytics events into summaries
# Example: 60 = aggregate events every 1 minute, 3600 = every 1 hour
AGGREGATION_WINDOW=3600

# Number of days to retain raw analytics data before automatic deletion
# Applies to general analytics data (non-personal)
# Example: 90 = keep data for 90 days
RETENTION_DAYS=90

# =============================================================================
# GDPR & COMPLIANCE CONFIGURATION
# =============================================================================

# Number of days to retain personally identifiable information (PII) and
# user-specific analytics data in compliance with GDPR regulations
# Must be compliant with applicable data protection laws in your jurisdiction
# Example: 30 = delete personal data after 30 days
GDPR_RETENTION=30
